{
  "name": "saucedemo-cypress-tests",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "cypress run",
    "cy:headed": "cypress run --headed",
    "cy:open": "cypress open",
    "merge-reports": "mochawesome-merge cypress/reports/mochawesome/*.json > mochawesome.json",
    "generate-report": "marge mochawesome.json -f report -o cypress/reports/mochawesome",
    "cy:report": "npm run cy:headed && npm run merge-reports && npm run generate-report",
    "clean:reports": "rimraf cypress/reports/mochawesome/*.json mochawesome.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndyTex2003/saucedemo-cypress-tests.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/AndyTex2003/saucedemo-cypress-tests/issues"
  },
  "homepage": "https://github.com/AndyTex2003/saucedemo-cypress-tests#readme",
  "devDependencies": {
    "cypress": "^15.14.1",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2"
  }
}
